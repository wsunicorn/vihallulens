# --- Dữ liệu: không commit, chỉ giữ lại MANIFEST.md ---
data/*
!data/raw/
data/raw/*
!data/raw/MANIFEST.md

# --- Tài liệu hành chính và bài báo tham khảo: chỉ giữ trên máy ---
# Riêng bộ slide trình bày thì commit (git không cho gỡ bỏ loại trừ cho thư mục con nếu cha bị loại cả thư mục, nên dùng /*)
UniversityRequirements/*
!UniversityRequirements/Slides/
reference_papers/

# --- Kết quả nặng ---
results/*.npz
results/*.npy

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Bí mật ---
.env

# --- Hệ điều hành và IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# Báo cáo rò rỉ của lần chạy một phần (--only) — sinh lại được, không cần commit
results/leakage_report_*.md
!results/leakage_report.md

# Ảnh nguồn của trang chủ: chỉ commit WebP đã nén; PNG gốc từ GPT image và ảnh tham chiếu để ngoài
src/vihallulens/serve/static/img/*.png
src/vihallulens/serve/static/img/original.*

# --- Báo cáo khóa luận: chỉ commit nguồn và hình quyển đang dùng (docs/report/README.md) ---
# Tệp do docs/tools/resolve.py và build_docx.py dựng ra
docs/BaoCao_KLTN.md
docs/BaoCao_KLTN.docx
docs/BaoCao_KLTN.pdf
# Tệp trung gian của script vẽ hình (SVG/HTML rồi mới chụp thành PNG)
docs/media/*.svg
docs/media/*.html
# Hình script vẫn vẽ nhưng đã bỏ khỏi quyển; đưa hình nào trở lại quyển thì xóa dòng của nó
